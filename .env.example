# Copy to .env only when you need local overrides. Never commit credentials.
AWS_REGION=us-east-1
AWS_PROFILE=genai-course

# Default model used by the introductory labs. It can be overridden when needed.
BEDROCK_TEXT_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_EMBEDDING_MODEL_ID=

# M04 image generation uses an active Stability AI model available in us-west-2.
BEDROCK_IMAGE_MODEL_ID=stability.stable-image-core-v1:1
BEDROCK_IMAGE_REGION=us-west-2

# Optional application settings
COURSE_DEBUG=true
